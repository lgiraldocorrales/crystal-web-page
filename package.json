{
  "name": "crystal-web-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "astro dev",
    "prebuild": "npm run prepare:assets",
    "build": "astro build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "astro preview",
    "check": "astro check && node tests/build-check.mjs",
    "test": "npm run build && npm run check",
    "test:pages": "node --test tests/pages-preview.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/raleway": "5.3.0",
    "astro": "7.3.6",
    "gsap": "3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "typescript": "5.9.3"
  }
}
